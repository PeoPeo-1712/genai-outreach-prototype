# ==============================================================================
# GenAI Fund - Talent Discovery & Outreach Prototype (.env.example)
# Copy this file to .env and configure your credentials.
# ==============================================================================

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (used for evidence-grounded scoring and personalized DM drafting)
# Get a key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY="your_gemini_api_key"
# Optional: customize model (default is gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# X (Twitter) Developer App - OAuth 2.0 User-Context (PKCE)
# Register at developer.x.com with Type: "Web App" (Confidential Client)
# Callback URL in portal: http://localhost:3000/api/auth/x/callback (and 127.0.0.1:3000)
# (Note: X_REDIRECT_URI is dynamically calculated per-request; do NOT set it here)
X_CLIENT_ID="your_oauth2_client_id"
X_CLIENT_SECRET="your_oauth2_client_secret"

# X App-Only Bearer Token (Optional: used for public tweet search & profile read)
X_BEARER_TOKEN="your_x_bearer_token"

# Optional: OAuth 1.0a 4-key credentials (fallback for app owner)
# X_API_KEY=""
# X_API_SECRET=""
# X_ACCESS_TOKEN=""
# X_ACCESS_SECRET=""

# Exa.ai API Key (Optional: for AI hybrid web & profile discovery)
EXA_API_KEY="your_exa_api_key"

# Sandbox Safety Gate (Comma-separated list of authorized test X handles)
# When NODE_ENV !== 'production', outreach DMs will ONLY be sent to handles in this list.
# Leave empty or unset in production once live outreach is approved.
ALLOWED_TEST_HANDLES="authorized_test_handle"
